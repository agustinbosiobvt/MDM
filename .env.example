# BVT MDM: copy to .env and fill in. Never commit .env.
# Generate secrets with:  make secrets   (prints fresh random values)

# --- Environment -------------------------------------------------------------
APP_ENV=local                      # local | test | production
WEB_ORIGIN=http://localhost:8080   # the only browser origin; always "localhost", never 127.0.0.1
LOG_LEVEL=INFO

# --- Postgres (Compose "db" service, host port 54330) ------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me      # superuser of the db container only
MDM_MIGRATOR_PASSWORD=change-me            # DDL, Alembic only
MDM_APP_PASSWORD=change-me                 # the API
MDM_READONLY_PASSWORD=change-me            # future reporting

# Used when running the API / Alembic / pytest on the host. Use 127.0.0.1, not
# "localhost": on Windows, localhost tries IPv6 first and hangs (the port is IPv4-only).
# Inside Compose the api service builds its own URLs pointing at host "db".
# Non-local hosts must add ?sslmode=require (the API refuses to start otherwise).
DATABASE_URL=postgresql+psycopg://mdm_app:change-me@127.0.0.1:54330/mdm?connect_timeout=10
MIGRATION_DATABASE_URL=postgresql+psycopg://mdm_migrator:change-me@127.0.0.1:54330/mdm?connect_timeout=10
TEST_DATABASE_NAME=mdm_test

# --- Google OIDC -----------------------------------------------------------------
# Create the client as described in README "Google OAuth client" (consent screen: Internal).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
ALLOWED_HOSTED_DOMAIN=buenavidatrading.com
BOOTSTRAP_ADMIN_EMAIL=

# --- Sessions --------------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
AUTH_RATE_LIMIT=20/minute          # /auth/login and /auth/callback, per client IP

# --- Imports (Phase 6) -------------------------------------------------------
UPLOAD_DIR=./api/var/uploads       # outside any web root
UPLOAD_MAX_BYTES=20971520
IMPORT_RATE_LIMIT=30/minute        # upload / validate / commit, per client IP
